JWT_SECRET=your_secret_key
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# db config mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=your_database_name

RECAPTCHA_SECRET_KEY=your_secret_key

# email config
GMAIL_USER=your_gmail
GMAIL_APP_PASSWORD=your_app_password

# APP CONFIG
DEFAULT_PAGE_LIMIT=10
MAX_OPERATORS_PER_PUSKESMAS=2

# THROTTLER CONFIG (ms)
THROTTLER_SHORT_TTL=1000
THROTTLER_SHORT_LIMIT=10
THROTTLER_MEDIUM_TTL=60000
THROTTLER_MEDIUM_LIMIT=100
THROTTLER_LONG_TTL=3600000
THROTTLER_LONG_LIMIT=1000

# CACHE CONFIG (ms)
CACHE_TTL=60000
CACHE_MAX=100

# STORAGE CONFIG
STORAGE_ROOT=/data/pkm-storage
UPLOAD_SIZE_PROFILE=2097152
UPLOAD_SIZE_GALLERY=3145728
UPLOAD_SIZE_VIDEO=15728640
UPLOAD_SIZE_BANNER=5242880
UPLOAD_SIZE_DOCUMENT=10485760
UPLOAD_SIZE_PAGES=10485760
UPLOAD_SIZE_STATIC_PAGES=10485760
UPLOAD_SIZE_WEB_INFO=2097152